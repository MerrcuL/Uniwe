<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_block_muted"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="8dp">

    <TextView
        android:id="@+id/widget_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingMultiplier="0.9"
        android:maxLines="2"
        android:textColor="@color/widget_on_surface"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_row_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:background="@drawable/widget_pill"
        android:maxLines="1"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:textColor="@color/widget_on_primary_container"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
