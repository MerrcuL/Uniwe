<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch screen. It shows no icon: the app draws its
         animated logo (lib/widgets/splash_overlay.dart) right after this, on
         a matching background, so the hand-over is seamless. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/system_neutral1_900</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
